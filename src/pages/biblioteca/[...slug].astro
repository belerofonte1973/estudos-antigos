---
import { getCollection, render } from 'astro:content';
import BibliotecaLayout from '../../layouts/BibliotecaLayout.astro';

export async function getStaticPaths() {
	const dossies = await getCollection('biblioteca');
	const artigos = await getCollection('artigos');

	const entradaDoDossie = new Map(
		artigos.filter((a) => a.data.dossie).map((a) => [a.data.dossie!, a])
	);

	const nav = dossies.map((d) => ({
		href: `/biblioteca/${d.id}/`,
		label: d.data.title.replace(/\s+—\s+Artigo Enciclopédico$/, ''),
		area: d.data.area,
		ordem: d.data.ordem,
	}));

	return dossies.map((dossie) => {
		const entrada = entradaDoDossie.get(dossie.id);
		return {
			params: { slug: dossie.id },
			props: {
				dossie,
				nav,
				entrada: entrada
					? { href: `/artigos/${entrada.id}/`, titulo: entrada.data.titulo }
					: undefined,
			},
		};
	});
}

const { dossie, nav, entrada } = Astro.props;
const { Content, headings } = await render(dossie);

// Livro bíblico do dossiê: `livro` para os de um livro só; Samuel e Reis são
// uma unidade canônica cada, e o primeiro slug serve de âncora para leitura.
const livro = dossie.data.livro ?? dossie.data.livros[0];
// Chave dos pré-requisitos: o último segmento do id ('biblia/samuel' -> 'samuel').
// Samuel e Reis são uma unidade canônica — o dossiê é 'samuel', mas o livro
// para montar o link da Bíblia é 'samuel-1'. São coisas diferentes.
const chave = dossie.id.split('/').pop();
---

<BibliotecaLayout
	title={dossie.data.title}
	description={dossie.data.description}
	area={dossie.data.area}
	headings={headings}
	nav={nav}
	currentId={dossie.id}
	atualizado={dossie.data.atualizado}
	entrada={entrada}
	livro={livro}
	chave={chave}
>
	<Content />
</BibliotecaLayout>
