---
import Icon from './Icon.astro';
import {EIXOS, LIVROS} from '../taxonomia';

const ANO = new Date().getFullYear();

const PROJETO = [
	{ href: '/artigos/', label: 'Revista' },
	{ href: '/biblioteca/', label: 'Biblioteca' },
	{ href: '/como-pesquisar/', label: 'Como pesquisar' },
	{ href: '/sobre/', label: 'Sobre o projeto' },
	{ href: '/sobre/contribua/', label: 'Como contribuir' },
];

const EIXOS_NAV = [
	{ href: '/biblia/', label: `${EIXOS.nucleo.nome} — ${EIXOS.nucleo.rotulo}` },
	{ href: '/contexto/', label: `${EIXOS.contexto.nome} — ${EIXOS.contexto.rotulo}` },
	{ href: '/recepcao/', label: `${EIXOS.recepcao.nome} — ${EIXOS.recepcao.rotulo}` },
];

const LIVROS_NAV = Object.entries(LIVROS).map(([slug, m]) => ({
	href: `/biblia/${slug}/`,
	label: m.nome,
}));
---

<footer class="ea-footer">
	<div class="wrap">
		<div class="ea-footer__grid">
			<div class="ea-footer__brand">
				<strong>Estudos Antigos</strong>
				<p>
					Portal independente de pesquisa e divulgação sobre Antiguidade Bíblica,
					Clássica e Idade Média. Cada afirmação factual traz citação
					rastreável a fonte primária.
				</p>
				<p class="ea-footer__legend">
					<span class="status-v">[V]</span> verificado ·
					<span class="status-w">[W]</span> provável ·
					<span class="status-gap">[—]</span> lacuna
				</p>
			</div>

			<nav class="ea-footer__col" aria-label="Eixos">
				<h2 class="ea-footer__title">Eixos</h2>
				<ul>
					{
						EIXOS_NAV.map((i) => (
							<li>
								<a href={i.href}>{i.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="ea-footer__col" aria-label="Livros bíblicos">
				<h2 class="ea-footer__title">Livros</h2>
				<ul>
					{
						LIVROS_NAV.map((i) => (
							<li>
								<a href={i.href}>{i.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="ea-footer__col" aria-label="Projeto">
				<h2 class="ea-footer__title">Projeto</h2>
				<ul>
					{
						PROJETO.map((i) => (
							<li>
								<a href={i.href}>{i.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="ea-footer__col" aria-label="Acompanhar">
				<h2 class="ea-footer__title">Acompanhar</h2>
				<ul>
					<li>
						<a href="/rss.xml"><Icon name="rss" size={14} /> Feed RSS</a>
					</li>
					<li>
						<a href="/sitemap-index.xml"><Icon name="globe" size={14} /> Mapa do site</a>
					</li>
					<li>
						<a
							href="https://github.com/belerofonte1973/estudos-antigos"
							rel="noopener noreferrer"
							target="_blank"
							><Icon name="link" size={14} /> Código-fonte</a
						>
					</li>
				</ul>
			</nav>
		</div>

		<div class="ea-footer__base">
			<p>
				© {ANO} Estudos Antigos · Conteúdo de acesso livre, sem fins comerciais.
			</p>
			<p class="ea-footer__note">
				Material didático. Para citação acadêmica, confira sempre a fonte
				primária indicada.
			</p>
		</div>
	</div>
</footer>

<style>
	.ea-footer {
		margin-top: var(--section);
		padding: 3rem 0 2rem;
		background: var(--bg-warm);
		border-top: 1px solid var(--border);
		font-size: 0.88rem;
	}

	.ea-footer__grid {
		display: grid;
		grid-template-columns: 1.6fr repeat(4, 1fr);
		gap: 2rem;
	}

	.ea-footer__brand strong {
		font-size: 1rem;
		letter-spacing: -0.3px;
	}
	.ea-footer__brand p {
		color: var(--ink-2);
		margin: 0.6rem 0 0;
		max-width: 42ch;
		line-height: 1.6;
	}
	.ea-footer__legend {
		font-size: 0.78rem;
		color: var(--ink-3);
	}

	.ea-footer__title {
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--ink-3);
		margin: 0 0 0.8rem;
	}

	.ea-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.ea-footer__col a {
		color: var(--ink-2);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.ea-footer__col a:hover {
		color: var(--accent);
	}

	.ea-footer__base {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		color: var(--ink-3);
		font-size: 0.8rem;
	}
	.ea-footer__base p {
		margin: 0;
	}
	.ea-footer__note {
		max-width: 46ch;
	}

	@media (max-width: 1000px) {
		.ea-footer__grid {
			grid-template-columns: 1fr 1fr 1fr;
		}
		.ea-footer__brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 620px) {
		.ea-footer__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 420px) {
		.ea-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
