---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	image?: string;
	/** Texto alternativo da imagem social (acompanha `image`). */
	imageAlt?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
	area?: string;
	tags?: string[];
	/**
	 * Rótulo de tipo indexado pelo Pagefind (`data-pagefind-meta`): "Dossiê",
	 * "Artigo", "Hub". Vive aqui porque é o `<main>` que delimita o que a busca
	 * indexa — sidebar, cabeçalho e rodapé ficam fora por construção.
	 */
	pfTipo?: string;
	/** Largura do conteúdo: 'wide' para grades, 'narrow' para leitura. */
	width?: 'wide' | 'narrow';
	class?: string;
}

const {
	title = 'Estudos Antigos',
	description = 'Portal independente de pesquisa e divulgação sobre Antiguidade Bíblica, Clássica e Idade Média. Cada afirmação com citação rastreável.',
	type = 'website',
	publishedTime,
	modifiedTime,
	image,
	imageAlt,
	jsonLd,
	noindex = false,
	area,
	tags = [],
	pfTipo,
	width = 'wide',
	class: cls = '',
} = Astro.props;

/**
 * O que entra no índice de busca.
 *
 * Marcar `data-pagefind-body` em toda página indexaria também o que é
 * navegação: home, hubs de eixo, hubs de cânon, o índice da biblioteca e a
 * própria página de busca apareceriam como resultado, competindo com o
 * conteúdo. A regra é explícita: só entra quem declara `pfTipo` (Dossiê,
 * Artigo, Passagem, Página) — e quem pediu `noindex` fica fora até do índice
 * local, pelo mesmo motivo.
 */
const indexavel = Boolean(pfTipo) && !noindex;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<!-- Anti-flash: precisa rodar antes da primeira pintura -->
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('ea-theme');
					const dark = saved
						? saved === 'dark'
						: window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.dataset.theme = dark ? 'dark' : 'light';
				} catch (e) {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>

		<Seo
			title={title}
			description={description}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			image={image}
			imageAlt={imageAlt}
			jsonLd={jsonLd}
			noindex={noindex}
			area={area}
			tags={tags}
		/>
	</head>

	<body>
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

		<Header />

		<main
			id="conteudo"
			class={cls}
			data-pagefind-body={indexavel ? '' : undefined}
			data-pagefind-ignore={indexavel ? undefined : ''}
			data-pagefind-meta={pfTipo && indexavel ? `tipo:${pfTipo}` : undefined}
		>
			<div class={width === 'narrow' ? 'wrap-narrow' : 'wrap'}>
				<slot />
			</div>
		</main>

		<Footer />

		<script is:inline>
			// Alternância de tema. Persiste em localStorage; a escolha do
			// sistema é o padrão na primeira visita.
			(() => {
				const btn = document.querySelector('.ea-theme-toggle');
				if (!btn) return;
				btn.addEventListener('click', () => {
					const atual = document.documentElement.dataset.theme;
					const proximo = atual === 'dark' ? 'light' : 'dark';
					document.documentElement.dataset.theme = proximo;
					try {
						localStorage.setItem('ea-theme', proximo);
					} catch (e) {}
				});
			})();

			// Entrada suave dos blocos marcados. Respeita prefers-reduced-motion.
			(() => {
				const alvos = document.querySelectorAll('.reveal');
				if (!alvos.length) return;
				const reduz =
					window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduz || !('IntersectionObserver' in window)) {
					alvos.forEach((el) => el.classList.add('is-visible'));
					return;
				}
				const obs = new IntersectionObserver(
					(entradas) => {
						entradas.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add('is-visible');
								obs.unobserve(e.target);
							}
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
				);
				alvos.forEach((el) => obs.observe(el));
			})();

			// Destaque do item atual no índice lateral.
			(() => {
				const links = document.querySelectorAll('.ea-toc a[href^="#"]');
				if (!links.length || !('IntersectionObserver' in window)) return;
				const mapa = new Map();
				links.forEach((a) => {
					const id = decodeURIComponent(a.getAttribute('href').slice(1));
					const alvo = document.getElementById(id);
					if (alvo) mapa.set(alvo, a);
				});
				const obs = new IntersectionObserver(
					(entradas) => {
						entradas.forEach((e) => {
							const a = mapa.get(e.target);
							if (!a) return;
							if (e.isIntersecting) {
								links.forEach((l) => l.classList.remove('is-active'));
								a.classList.add('is-active');
							}
						});
					},
					{ rootMargin: '-72px 0px -70% 0px' }
				);
				mapa.forEach((_, alvo) => obs.observe(alvo));
			})();
		</script>
	</body>
</html>
