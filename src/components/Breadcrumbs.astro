---
interface Item {
	href?: string;
	label: string;
}

interface Props {
	items: Item[];
	class?: string;
}

const { items, class: cls = '' } = Astro.props;
---

<nav class={`ea-crumbs ${cls}`} aria-label="Trilha de navegação">
	<ol>
		{
			items.map((item, i) => {
				const last = i === items.length - 1;
				return (
					<li>
						{item.href && !last ? (
							<a href={item.href}>{item.label}</a>
						) : (
							<span aria-current="page">{item.label}</span>
						)}
						{!last && <span class="sep" aria-hidden="true">/</span>}
					</li>
				);
			})
		}
	</ol>
</nav>

<style>
	.ea-crumbs {
		margin-bottom: 1.2rem;
	}
	.ea-crumbs ol {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.78rem;
	}
	.ea-crumbs li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.ea-crumbs a {
		color: var(--ink-3);
		border-bottom: 0;
	}
	.ea-crumbs a:hover {
		color: var(--accent);
	}
	.ea-crumbs span[aria-current] {
		color: var(--ink-2);
		font-weight: 500;
	}
	.ea-crumbs .sep {
		color: var(--ink-3);
		opacity: 0.6;
	}
</style>
